{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 740,
        "minHeight": 740,
        "minWidth": 1120,
        "title": "BlueLink",
        "width": 1120
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "app.bluelink.desktop",
  "productName": "BlueLink",
  "version": "2.5.1"
}
